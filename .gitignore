.DS_Store
docs/superpowers/
*.pre-stow
*.bak
# machine-local overrides, e.g. .zshrc.local
*.local
# herdr-managed; lands here only if ~/.claude/hooks was stow-folded
claude/.claude/hooks/herdr-agent-state.sh
# herdr runtime state (logs, sockets, session.json); lands here only if
# ~/.config/herdr was stow-folded
herdr/.config/herdr/*
!herdr/.config/herdr/config.toml
herdr-linux/.config/herdr/*
!herdr-linux/.config/herdr/config.toml

# Per-machine skills-CLI state: it lists the local skills too.
agents/.agents/.skill-lock.json

# Skills are local by default; only the allowlisted general ones are tracked.
agents/.agents/skills/*
!agents/.agents/skills/caveman-commit/
!agents/.agents/skills/find-skills/
!agents/.agents/skills/frontend-design/
!agents/.agents/skills/grill-me/
!agents/.agents/skills/grill-with-docs/
!agents/.agents/skills/herdr/
!agents/.agents/skills/improve-codebase-architecture/
!agents/.agents/skills/linear-ticket-workflow/
!agents/.agents/skills/release-notes/
