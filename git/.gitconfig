[init]
	defaultBranch = main
[pull]
	rebase = true
[push]
	autoSetupRemote = true
[fetch]
	prune = true
[rerere]
	enabled = true
[gpg]
	format = ssh
[commit]
	gpgsign = true
# Machine-local settings: [user] identity and signing key, credential helpers.
# Untracked; git silently skips it when absent.
[include]
	path = ~/.gitconfig.local
